# Copy this file to .env and add your OpenRouter key.
# NEVER commit .env or share your key.
OPENROUTER_API_KEY=replace_me

# Model to use at startup. Must be an EXACT OpenRouter model ID
# (find IDs at https://openrouter.ai/models), e.g. openrouter/free or cohere/command-a.
# Do not put a display name like "Cohere: Command A" here.
GRYPHOS_DEFAULT_MODEL=openrouter/free

# REQUIRED: explicit authorized lab scope. Use individual IPs or CIDRs.
# Keep this limited to systems you own or have written permission to test.
# Default permits only localhost:
GRYPHOS_ALLOWED_TARGETS=127.0.0.1/32

# Optional: OpenRouter API base (override only for compatible gateways).
#GRYPHOS_API_BASE=https://openrouter.ai/api/v1

# Safety and performance limits (defaults shown; values are clamped to safe ranges).
#GRYPHOS_COMMAND_TIMEOUT=45          # seconds per tool execution (5-300)
#GRYPHOS_MAX_OUTPUT_CHARS=12000      # tool output kept per result (1000-100000)
#GRYPHOS_MAX_AGENT_STEPS=6           # agent loop step limit (1-20)
#GRYPHOS_REQUEST_TIMEOUT=60          # LLM request timeout seconds (5-300)
#GRYPHOS_MAX_RETRIES=1               # transient LLM retries (0-5)
#GRYPHOS_TIME_BUDGET_SECONDS=600     # total assessment time budget (30-3600)
#GRYPHOS_MODEL_CACHE_TTL=300         # model catalog cache seconds (0-86400)
